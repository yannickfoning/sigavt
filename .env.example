# Copier ce fichier en .env et remplir les valeurs réelles
# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sigavt
DB_USER=root
DB_PASSWORD=

# MySQL root (seulement pour docker-compose)
MYSQL_ROOT_PASSWORD=changez-moi-en-production

# JWT — générer avec : openssl rand -base64 64 (ou équivalent PowerShell)
JWT_SECRET=changez-moi-en-production

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Environnement
SPRING_PROFILES_ACTIVE=mysql
PORT=8081
