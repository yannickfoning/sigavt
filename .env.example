# Copier ce fichier en .env et remplir les valeurs réelles
# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sigavt
DB_USER=sigavt_user
DB_PASSWORD=CHANGER_ICI

# MySQL root (seulement pour docker-compose)
MYSQL_ROOT_PASSWORD=CHANGER_ICI

# JWT — générer avec : openssl rand -base64 64
JWT_SECRET=GENERER_AVEC_openssl_rand_-base64_64

# CORS
CORS_ALLOWED_ORIGINS=https://sigavt.cm

# Environnement
SPRING_PROFILES_ACTIVE=prod
PORT=8080
