
  /* ── SIDEBAR ── */
  .sidebar {
    width: var(--sidebar-w);
    background: var(--navy);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: fixed;
    left: 0; top: 0; bottom: 0;
    z-index: 100;
    transition: transform 0.3s ease;
  }

  .sidebar-logo {
    padding: 18px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .sidebar-logo h1 {
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sidebar-logo span {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    display: block;
    margin-top: 2px;
    font-weight: 400;
  }

  .sidebar-nav {
    flex: 1;
    padding: 12px 0;
    overflow-y: auto;
  }

  .nav-section {
    padding: 8px 16px 4px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.35);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    color: rgba(255,255,255,0.7);
    cursor: pointer;
    border-left: 3px solid transparent;
    transition: all 0.15s ease;
    font-size: 13.5px;
    text-decoration: none;
  }
  .nav-item:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .nav-item.active {
    background: rgba(245,166,35,0.15);
    color: var(--gold);
    border-left-color: var(--gold);
    font-weight: 600;
  }
  .nav-item .icon { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }
  .nav-badge {
    margin-left: auto;
    background: var(--orange);
    color: #fff;
    border-radius: 10px;
    font-size: 10px;
    padding: 1px 6px;
    font-weight: 700;
  }

  .sidebar-footer {
    padding: 12px 16px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .user-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 13px;
    flex-shrink: 0;
  }
  .avatar-orange { background: var(--orange); color: #fff; }
  .avatar-blue { background: var(--blue-accent); color: #fff; }
  .avatar-green { background: var(--green); color: #fff; }
  .avatar-purple { background: var(--purple); color: #fff; }
  .avatar-teal { background: var(--teal); color: #fff; }
  .avatar-red { background: var(--red); color: #fff; }
  .user-info .name { color: #fff; font-size: 13px; font-weight: 600; }
  .user-info .role { color: rgba(255,255,255,0.45); font-size: 11px; }

  /* ── MAIN ── */
  .main {
    margin-left: var(--sidebar-w);
    flex: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── TOP BAR ── */
  .topbar {
    background: #fff;
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .topbar-title { font-size: 17px; font-weight: 700; color: var(--navy); }
  .topbar-sub { font-size: 12px; color: var(--text-muted); margin-top: 1px; }
  .topbar-actions { display: flex; align-items: center; gap: 10px; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px; border-radius: 7px;
    font-size: 13px; font-weight: 600;
    cursor: pointer; border: none;
    transition: all 0.15s ease;
    text-decoration: none;
  }
  .btn-primary { background: var(--orange); color: #fff; }
  .btn-primary:hover { background: var(--orange-light); }
  .btn-outline { background: transparent; color: var(--navy); border: 1.5px solid var(--border); }
  .btn-outline:hover { border-color: var(--navy); }
  .btn-ghost { background: transparent; color: var(--text-muted); padding: 7px 10px; }
  .btn-ghost:hover { background: var(--bg); color: var(--text); }
  .btn-blue { background: var(--blue-accent); color: #fff; }
  .btn-blue:hover { background: #2563eb; }
  .btn-green { background: var(--green); color: #fff; }
  .btn-green:hover { background: #059669; }
  .btn-sm { padding: 5px 10px; font-size: 12px; }
  .btn-icon { padding: 7px; position: relative; }

  .notif-dot {
    position: absolute; top: 4px; right: 4px;
    width: 8px; height: 8px; background: var(--orange); border-radius: 50%;
    border: 2px solid #fff;
  }

  /* ── PAGE CONTENT ── */
  .page { display: none; padding: 24px; }
  .page.active { display: block; }

  /* ── CARDS ── */
  .card {
    background: var(--bg-card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .card-header {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .card-header h3 { font-size: 14px; font-weight: 700; color: var(--navy); }
  .card-body { padding: 18px; }

  /* ── STATS GRID ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .stat-card {
    background: var(--bg-card);
    border-radius: var(--radius);
    padding: 18px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .stat-label { font-size: 12px; color: var(--text-muted); font-weight: 500; }
  .stat-value { font-size: 26px; font-weight: 800; color: var(--navy); margin: 6px 0 4px; line-height: 1; }
  .stat-value .unit { font-size: 13px; font-weight: 500; color: var(--text-muted); margin-left: 2px; }
  .stat-meta { font-size: 11px; color: var(--text-light); }
  .badge-change {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 11px; font-weight: 700; border-radius: 20px; padding: 2px 8px;
  }
  .badge-up { background: #dcfce7; color: #166534; }
  .badge-down { background: #fee2e2; color: #991b1b; }
  .badge-neutral { background: #fef3c7; color: #92400e; }

  /* ── GRID LAYOUTS ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

  /* ── TABLE ── */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th {
    text-align: left; padding: 10px 14px;
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--text-muted);
    border-bottom: 2px solid var(--border);
    background: #f8fafc;
  }
  td { padding: 12px 14px; border-bottom: 1px solid var(--border); font-size: 13.5px; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: #f8fafc; }
  .td-bold { font-weight: 700; }

  /* ── BADGES / STATUS ── */
  .badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px; border-radius: 20px;
    font-size: 11px; font-weight: 700;
  }
  .badge-green { background: #dcfce7; color: #166534; }
  .badge-orange { background: #ffedd5; color: #c2410c; }
  .badge-blue { background: #dbeafe; color: #1d4ed8; }
  .badge-yellow { background: #fef3c7; color: #92400e; }
  .badge-red { background: #fee2e2; color: #991b1b; }
  .badge-purple { background: #ede9fe; color: #6d28d9; }
  .badge-gray { background: #f1f5f9; color: #475569; }

  /* ── PROGRESS BAR ── */
  .progress { background: #e2e8f0; border-radius: 4px; height: 6px; overflow: hidden; }
  .progress-bar { height: 100%; border-radius: 4px; transition: width 0.3s; }
  .progress-blue { background: var(--blue-accent); }
  .progress-orange { background: var(--orange); }
  .progress-green { background: var(--green); }
  .progress-red { background: var(--red); }

  /* ── SEAT MAP ── */
  .seat-map {
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .seat-map-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    color: var(--text-muted); text-transform: uppercase;
    padding: 6px 30px; border: 1px solid var(--border);
    border-radius: 6px; margin: 4px 0;
    background: white; width: 100%; text-align: center;
  }
  .seat-row { display: flex; gap: 6px; align-items: center; }
  .seat-aisle { width: 20px; }
  .seat {
    width: 32px; height: 28px; border-radius: 5px;
    font-size: 10px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; border: 1.5px solid transparent;
    transition: all 0.15s;
  }
  .seat-free { background: #f0f9ff; border-color: #bae6fd; color: var(--blue-accent); }
  .seat-free:hover { background: var(--blue-accent); color: #fff; border-color: var(--blue-accent); }
  .seat-taken { background: #fee2e2; border-color: #fca5a5; color: var(--red); cursor: not-allowed; }
  .seat-selected { background: var(--blue-accent); color: #fff; border-color: #1d4ed8; }
  .seat-legend { display: flex; gap: 14px; margin-top: 4px; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-muted); }
  .legend-dot { width: 12px; height: 12px; border-radius: 3px; }

  /* ── FORMS ── */
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-group.full { grid-column: 1 / -1; }
  label { font-size: 12px; font-weight: 600; color: var(--text-muted); }
  label .req { color: var(--red); }
  input, select, textarea {
    padding: 9px 12px;
    border: 1.5px solid var(--border);
    border-radius: 7px;
    font-size: 13.5px;
    color: var(--text);
    background: #fff;
    outline: none;
    transition: border-color 0.15s;
    font-family: inherit;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--blue-accent); }
  textarea { resize: vertical; min-height: 70px; }

  /* ── STEP INDICATOR ── */
  .steps {
    display: flex; align-items: center; gap: 0;
  }
  .step-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 600;
    color: var(--text-light);
    padding: 0 10px;
    position: relative;
  }
  .step-item:first-child { padding-left: 0; }
  .step-num {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--border); color: var(--text-muted);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 800; flex-shrink: 0;
  }
  .step-item.done .step-num { background: var(--navy); color: #fff; }
  .step-item.active .step-num { background: var(--blue-accent); color: #fff; }
  .step-item.active { color: var(--navy); }
  .step-sep {
    flex: 1; height: 1.5px; background: var(--border); min-width: 20px;
  }
  .step-sep.done { background: var(--navy); }

  /* ── TIMELINE ── */
  .timeline { display: flex; flex-direction: column; gap: 0; }
  .timeline-item {
    display: flex; gap: 14px; padding-bottom: 18px;
    position: relative;
  }
  .timeline-item:last-child { padding-bottom: 0; }
  .tl-dot {
    width: 28px; height: 28px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 12px; color: #fff;
    flex-shrink: 0; position: relative; z-index: 1;
  }
  .tl-dot-blue { background: var(--blue-accent); }
  .tl-dot-green { background: var(--green); }
  .tl-dot-gray { background: var(--text-light); }
  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 13px; top: 28px; bottom: 0;
    width: 2px; background: var(--border);
  }
  .tl-content { flex: 1; padding-top: 2px; }
  .tl-title { font-weight: 700; font-size: 13.5px; }
  .tl-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
  .tl-time { font-size: 11px; color: var(--text-light); margin-left: auto; white-space: nowrap; }
  .tl-header { display: flex; align-items: flex-start; justify-content: space-between; }
  .tl-active { background: #eff6ff; border-radius: 8px; padding: 10px 12px; }

  /* ── GPS MAP PLACEHOLDER ── */
  .gps-map {
    background: linear-gradient(135deg, #e0f2fe 0%, #e8f5e9 100%);
    border-radius: var(--radius);
    height: 200px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .gps-map svg { width: 100%; height: 100%; }
  .map-label {
    position: absolute; bottom: 10px; right: 10px;
    background: rgba(255,255,255,0.9); padding: 4px 8px;
    border-radius: 5px; font-size: 10px; font-weight: 600; color: var(--text-muted);
  }

  /* ── PAYMENT BUTTONS ── */
  .payment-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .pay-btn {
    padding: 8px 14px; border-radius: 7px; border: 2px solid var(--border);
    font-size: 12px; font-weight: 700; cursor: pointer; background: #fff;
    transition: all 0.15s; color: var(--text);
  }
  .pay-btn.active { border-color: var(--navy); background: var(--navy); color: #fff; }
  .pay-btn:hover:not(.active) { border-color: var(--text-muted); }

  /* ── ALERTS ── */
  .alert {
    border-left: 4px solid;
    padding: 10px 14px;
    border-radius: 0 8px 8px 0;
    margin-bottom: 10px;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }
  .alert-red { border-color: var(--red); }
  .alert-orange { border-color: var(--orange); }
  .alert-blue { border-color: var(--blue-accent); }
  .alert-title { font-weight: 700; font-size: 13px; color: var(--text); }
  .alert-sub { font-size: 12px; color: var(--text-muted); margin-top: 1px; }

  /* ── BULLETIN DE PAIE ── */
  .pay-slip {
    background: var(--navy);
    border-radius: var(--radius);
    color: #fff;
    padding: 18px;
  }
  .pay-slip h4 { font-size: 13px; margin-bottom: 12px; opacity: 0.85; }
  .pay-row {
    display: flex; justify-content: space-between;
    font-size: 12.5px; padding: 4px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .pay-row:last-child { border-bottom: none; }
  .pay-row.total {
    font-weight: 800; font-size: 15px;
    background: rgba(255,255,255,0.1); border-radius: 6px;
    padding: 8px 10px; margin-top: 8px;
    border-bottom: none;
  }
  .pay-row .deduct { color: #fca5a5; }
  .pay-row .label { opacity: 0.8; }
  .pay-row .highlight { color: var(--gold); }
  .pay-section-title { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5; margin: 10px 0 4px; }

  /* ── EMPLOYEE CARD ── */
  .emp-card {
    display: flex; align-items: center; gap: 12px;
    padding: 12px; background: #fff;
    border: 1px solid var(--border); border-radius: var(--radius);
    margin-bottom: 10px; transition: box-shadow 0.15s;
  }
  .emp-card:hover { box-shadow: var(--shadow); }
  .emp-info { flex: 1; }
  .emp-name { font-weight: 700; font-size: 13.5px; color: var(--navy); }
  .emp-sub { font-size: 12px; color: var(--text-muted); margin-top: 1px; }
  .emp-meta { font-size: 11px; color: var(--text-light); margin-top: 2px; }
  .emp-actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }

  /* ── CHART BARS ── */
  .bar-chart {
    display: flex; align-items: flex-end; gap: 8px;
    height: 120px; padding: 0 4px;
  }
  .bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .bar {
    width: 100%; border-radius: 4px 4px 0 0;
    background: var(--blue-accent);
    position: relative; min-height: 4px;
    transition: background 0.15s;
  }
  .bar:hover { background: var(--navy); }
  .bar.highlight { background: var(--orange); }
  .bar-val { font-size: 9px; font-weight: 700; color: var(--text-muted); }
  .bar-label { font-size: 10px; color: var(--text-light); }

  /* ── DONUT CHART ── */
  .donut-wrap { position: relative; display: inline-flex; align-items: center; justify-content: center; }
  .donut-center {
    position: absolute; text-align: center;
  }
  .donut-center .num { font-size: 22px; font-weight: 800; color: var(--navy); line-height: 1; }
  .donut-center .sub { font-size: 10px; color: var(--text-muted); margin-top: 2px; }

  /* ── HORAIRE GRID ── */
  .horaire-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .horaire-btn {
    padding: 12px 10px; border: 2px solid var(--border); border-radius: 8px;
    text-align: center; cursor: pointer; transition: all 0.15s; background: #fff;
  }
  .horaire-btn.active { border-color: var(--navy); background: var(--navy); }
  .horaire-btn.active .horaire-time, .horaire-btn.active .horaire-places, .horaire-btn.active .horaire-price { color: #fff; }
  .horaire-time { font-size: 15px; font-weight: 800; color: var(--navy); }
  .horaire-places { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
  .horaire-price { font-size: 12px; font-weight: 700; color: var(--orange); margin-top: 4px; }

  /* ── TARIF BOX ── */
  .tarif-box {
    background: #f8fafc; border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 14px;
  }
  .tarif-title { font-size: 12px; font-weight: 700; color: var(--navy); margin-bottom: 8px; }
  .tarif-row { display: flex; justify-content: space-between; font-size: 12px; padding: 4px 0; }
  .tarif-row.tarif-total {
    font-weight: 800; font-size: 14px; padding-top: 8px; margin-top: 4px;
    border-top: 1px solid var(--border);
  }

  /* ── TRACKING NUM ── */
  .tracking-num {
    background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px;
    padding: 10px 14px; font-size: 13px; color: var(--navy);
  }
  .tracking-num strong { color: var(--blue-accent); }

  /* ── VOYAGE CARD ── */
  .voyage-card {
    transition: all 0.2s; cursor: pointer;
  }
  .voyage-card:hover { border-color: var(--blue-accent); background: #f0f9ff; }

  /* ── MODAL ── */
  .modal-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 200; opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  .modal-backdrop.open { opacity: 1; pointer-events: auto; }
  .modal {
    background: #fff; border-radius: var(--radius);
    width: 90%; max-width: 500px; max-height: 90vh;
    overflow-y: auto; box-shadow: var(--shadow-lg);
  }
  .modal-header {
    padding: 16px 18px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .modal-header h3 { font-size: 15px; font-weight: 700; color: var(--navy); }
  .close-btn {
    width: 28px; height: 28px; border-radius: 50%; border: none;
    background: var(--bg); cursor: pointer; font-size: 14px;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .close-btn:hover { background: var(--border); }
  .modal-body { padding: 18px; }
  .modal-footer {
    padding: 14px 18px; border-top: 1px solid var(--border);
    display: flex; gap: 10px; justify-content: flex-end;
  }

  /* ── OVERLAY (mobile sidebar) ── */
  .overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.4);
    z-index: 90; opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .overlay.open { opacity: 1; pointer-events: auto; }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .grid-2 { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .main { margin-left: 0; }
    .stats-grid { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .horaire-grid { grid-template-columns: 1fr; }
    .topbar-title { font-size: 15px; }
  }
</style>
</head>
<body>

<!-- SIDEBAR OVERLAY -->
<div class="sidebar-overlay" id="overlay" onclick="closeSidebar()"></div>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <h1>🚌 SIGAVT</h1>
    <span>Agence Voyage CM</span>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Principal</div>
    <a class="nav-item active" onclick="navigate('dashboard')">
      <span class="icon">📊</span> Tableau de bord
    </a>
    <div class="nav-section">Opérations</div>
    <a class="nav-item" onclick="navigate('billets')">
      <span class="icon">🎫</span> Billets
    </a>
    <a class="nav-item" onclick="navigate('colis')">
      <span class="icon">📦</span> Colis
    </a>
    <a class="nav-item" onclick="navigate('courriers')">
      <span class="icon">✉️</span> Courriers <span class="nav-badge">3</span>
    </a>
    <div class="nav-section">Gestion</div>
    <a class="nav-item" onclick="navigate('flotte')">
      <span class="icon">🚌</span> Flotte Bus
    </a>
    <a class="nav-item" onclick="navigate('personnel')">
      <span class="icon">👤</span> Personnel
    </a>
    <a class="nav-item" onclick="navigate('paie')">
      <span class="icon">💰</span> Paie
    </a>
    <div class="nav-section">Finance</div>
    <a class="nav-item" onclick="navigate('comptabilite')">
      <span class="icon">📋</span> Comptabilité
    </a>
    <a class="nav-item" onclick="navigate('lignes')">
      <span class="icon">🗺️</span> Lignes
    </a>
    <a class="nav-item" onclick="navigate('parametres')">
      <span class="icon">⚙️</span> Paramètres
    </a>
  </nav>
  <div class="sidebar-footer">
    <div class="user-info">
      <div class="avatar avatar-orange">A</div>
      <div>
        <div class="name">Admin Système</div>
        <div class="role">Super Admin</div>
      </div>
    </div>
    <button class="nav-item" onclick="logout()" style="margin-top: 12px; padding: 8px 16px;">
      <span class="icon">🚪</span> Déconnexion
    </button>
  </div>
</aside>

<!-- MAIN CONTENT -->
<main class="main">

  <!-- TOP BAR -->
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:12px">
      <button class="hamburger" onclick="openSidebar()">☰</button>
      <div>
        <div class="topbar-title" id="page-title">Tableau de bord</div>
        <div class="topbar-sub" id="page-sub">Mardi 6 Mai 2025 • Agence de Yaoundé</div>
      </div>
    </div>
    <div class="topbar-actions">
      <button class="btn btn-icon btn-ghost" style="position:relative" onclick="showNotifs()">
        🔔<span class="notif-dot"></span>
      </button>
      <button class="btn btn-icon btn-ghost">👤</button>
      <button class="btn btn-primary" id="topbar-cta" onclick="handleCTA()">+ Nouveau</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- PAGE: DASHBOARD                         -->
  <!-- ═══════════════════════════════════════ -->
  <div class="page active" id="page-dashboard">
    <!-- Date du jour -->
    <div style="margin-bottom:20px;padding:16px;background:linear-gradient(135deg,var(--navy),var(--navy-light));border-radius:12px;color:white;display:flex;justify-content:space-between;align-items:center">
      <div>
        <div style="font-size:12px;opacity:0.8;margin-bottom:4px">📅 Date du jour</div>
        <div id="today-date" style="font-size:24px;font-weight:700"></div>
      </div>
      <div id="next-trip" style="text-align:right">
        <div style="font-size:12px;opacity:0.8;margin-bottom:4px">🚀 Prochain voyage</div>
        <div id="next-trip-info" style="font-size:18px;font-weight:600">Chargement...</div>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Recettes du jour</div>
        <div class="stat-value"><span class="loading">...</span><span class="unit">FCFA</span></div>
        <div style="display:flex;align-items:center;gap:6px;margin-top:4px">
          <span class="stat-meta">aujourd'hui</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Billets vendus</div>
        <div class="stat-value"><span class="loading">...</span></div>
        <div style="display:flex;align-items:center;gap:6px;margin-top:4px">
          <span class="stat-meta">aujourd'hui</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Colis en transit</div>
        <div class="stat-value"><span class="loading">...</span></div>
        <div style="display:flex;align-items:center;gap:6px;margin-top:4px">
          <span class="stat-meta">en cours</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Bus en service</div>
        <div class="stat-value"><span class="loading">...</span></div>
        <div style="display:flex;align-items:center;gap:6px;margin-top:4px">
          <span class="stat-meta">opérationnels</span>
        </div>
      </div>
    </div>

    <div class="grid-2">
      <!-- Départs du jour -->
      <div class="card">
        <div class="card-header">
          <h3>🕐 Départs du jour</h3>
          <button class="btn btn-sm btn-primary" onclick="navigate('billets')">Voir tout</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Ligne</th><th>Départ</th><th>Places</th><th>Statut</th></tr>
            </thead>
            <tbody>
              <tr><td colspan="4" style="text-align:center;color:var(--text-muted)">Chargement...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right column -->
      <div style="display:flex;flex-direction:column;gap:20px">

        <!-- Recettes / semaine -->
        <div class="card">
          <div class="card-header"><h3>📈 Recettes / semaine</h3></div>
          <div class="card-body">
            <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px">FCFA (×1000)</div>
            <div class="bar-chart">
              <div class="bar-wrap">
                <div class="bar" style="height:55%" title="850k"></div>
                <div class="bar-val">850k</div>
                <div class="bar-label">Lun</div>
              </div>
              <div class="bar-wrap">
                <div class="bar" style="height:80%" title="1.1M"></div>
                <div class="bar-val">1.1M</div>
                <div class="bar-label">Mar</div>
              </div>
              <div class="bar-wrap">
                <div class="bar" style="height:90%" title="1.2M"></div>
                <div class="bar-val">1.2M</div>
                <div class="bar-label">Mer</div>
              </div>
              <div class="bar-wrap">
                <div class="bar" style="height:65%" title="900k"></div>
                <div class="bar-val">900k</div>
                <div class="bar-label">Jeu</div>
              </div>
              <div class="bar-wrap">
                <div class="bar highlight" style="height:48%" title="700k"></div>
                <div class="bar-val">700k</div>
                <div class="bar-label">Ven</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Alertes -->
        <div class="card">
          <div class="card-header">
            <h3>⚠️ Alertes</h3>
            <span class="badge badge-red">3</span>
          </div>
          <div class="card-body" style="padding-top:10px">
            <div class="alert alert-red">
              <div class="alert-title">Visite technique</div>
              <div class="alert-sub">Bus LT-1892 — expire dans 8j</div>
            </div>
            <div class="alert alert-blue">
              <div class="alert-title">Colis non réclamé</div>
              <div class="alert-sub">3 colis > 7 jours à Douala</div>
            </div>
            <div class="alert alert-orange">
              <div class="alert-title">Assurance expirée</div>
              <div class="alert-sub">Bus LT-0044 — à renouveler</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid-2" style="margin-top:20px">
      <!-- Top lignes -->
      <div class="card">
        <div class="card-header"><h3>🏆 Top lignes</h3></div>
        <div class="card-body">
          <div class="top-line">
            <div class="top-line-header"><span class="top-line-name">Yaoundé → Douala</span><span class="top-line-pct">93%</span></div>
            <div class="progress"><div class="progress-bar progress-blue" style="width:93%"></div></div>
          </div>
          <div class="top-line">
            <div class="top-line-header"><span class="top-line-name">Yaoundé → Bafoussam</span><span class="top-line-pct">70%</span></div>
            <div class="progress"><div class="progress-bar progress-blue" style="width:70%"></div></div>
          </div>
          <div class="top-line">
            <div class="top-line-header"><span class="top-line-name">Yaoundé → Bamenda</span><span class="top-line-pct">60%</span></div>
            <div class="progress"><div class="progress-bar progress-orange" style="width:60%"></div></div>
          </div>
          <div class="top-line">
            <div class="top-line-header"><span class="top-line-name">Douala → Kribi</span><span class="top-line-pct">45%</span></div>
            <div class="progress"><div class="progress-bar progress-orange" style="width:45%"></div></div>
          </div>
          <div class="top-line">
            <div class="top-line-header"><span class="top-line-name">Ngaoundéré → Ydé</span><span class="top-line-pct">33%</span></div>
            <div class="progress"><div class="progress-bar progress-red" style="width:33%"></div></div>
          </div>
        </div>
      </div>

      <!-- État flotte -->
      <div class="card">
        <div class="card-header"><h3>🚌 État de la flotte</h3></div>
        <div class="card-body" style="display:flex;gap:20px;align-items:center;flex-wrap:wrap">
          <div class="donut-wrap">
            <svg width="120" height="120" viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="48" fill="none" stroke="#e2e8f0" stroke-width="16"/>
              <!-- Opérationnel: 11/14 = 78.5% → 236.4 of 301.6 -->
              <circle cx="60" cy="60" r="48" fill="none" stroke="#3b82f6" stroke-width="16"
                stroke-dasharray="236 66" stroke-dashoffset="75" stroke-linecap="round"/>
              <!-- Maintenance: 2/14 = 14.3% → 43 of 301.6 -->
              <circle cx="60" cy="60" r="48" fill="none" stroke="#f59e0b" stroke-width="16"
                stroke-dasharray="43 259" stroke-dashoffset="-161" stroke-linecap="round"/>
              <!-- Hors service: 1/14 = 7.2% → 22 of 301.6 -->
              <circle cx="60" cy="60" r="48" fill="none" stroke="#ef4444" stroke-width="16"
                stroke-dasharray="22 280" stroke-dashoffset="-204" stroke-linecap="round"/>
            </svg>
            <div class="donut-center">
              <div class="num">14</div>
              <div class="sub">bus total</div>
            </div>
          </div>
          <div style="flex:1;min-width:120px">
            <div style="display:flex;flex-direction:column;gap:10px">
              <div style="display:flex;align-items:center;gap:8px">
                <div style="width:12px;height:12px;border-radius:3px;background:var(--blue-accent)"></div>
                <div>
                  <div style="font-weight:700;font-size:13px">11 bus</div>
                  <div style="font-size:11px;color:var(--text-muted)">Opérationnel</div>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:8px">
                <div style="width:12px;height:12px;border-radius:3px;background:var(--yellow)"></div>
                <div>
                  <div style="font-weight:700;font-size:13px">2 bus</div>
                  <div style="font-size:11px;color:var(--text-muted)">Maintenance</div>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:8px">
                <div style="width:12px;height:12px;border-radius:3px;background:var(--red)"></div>
                <div>
                  <div style="font-weight:700;font-size:13px">1 bus</div>
                  <div style="font-size:11px;color:var(--text-muted)">Hors service</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- PAGE: BILLETS                           -->
  <!-- ═══════════════════════════════════════ -->
  <div class="page" id="page-billets">
    <!-- Step indicator -->
    <div class="card" style="padding:16px 20px;margin-bottom:20px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
        <div>
          <div style="font-size:16px;font-weight:700;color:var(--navy)">Vente de Billet</div>
          <div style="font-size:12px;color:var(--text-muted)">Saisir les informations du passager et du voyage</div>
        </div>
        <div class="steps">
          <div class="step-item active" id="step-1"><div class="step-num">1</div>Trajet</div>
          <div class="step-sep"></div>
          <div class="step-item" id="step-2"><div class="step-num">2</div>Passager</div>
          <div class="step-sep"></div>
          <div class="step-item" id="step-3"><div class="step-num">3</div>Siège</div>
          <div class="step-sep"></div>
          <div class="step-item" id="step-4"><div class="step-num">4</div>Paiement</div>
        </div>
      </div>
    </div>

    <div class="grid-2">
      <!-- Formulaire -->
      <div class="card">
        <div class="card-header"><h3>📍 Informations du trajet</h3></div>
        <div class="card-body">
          <div class="form-grid">
            <div class="form-group">
              <label>Ville de départ <span class="req">*</span></label>
              <select id="billet-ville-depart">
                <option>Yaoundé</option>
                <option>Douala</option>
                <option>Bafoussam</option>
                <option>Bamenda</option>
                <option>Ngaoundéré</option>
              </select>
            </div>
            <div class="form-group">
              <label>Ville d'arrivée <span class="req">*</span></label>
              <select id="billet-ville-arrivee">
                <option>Douala</option>
                <option>Yaoundé</option>
                <option>Bafoussam</option>
                <option>Kribi</option>
                <option>Limbé</option>
              </select>
            </div>
            <div class="form-group">
              <label>Date du voyage <span class="req">*</span></label>
              <input type="date" id="billet-date" value="2025-05-06">
            </div>
            <div class="form-group">
              <label>Nombre de places</label>
              <div style="display:flex;align-items:center;gap:8px">
                <button class="btn btn-ghost" onclick="decrementPlaces()" style="border:1.5px solid var(--border);padding:7px 12px;font-size:16px">−</button>
                <span id="nb-places" style="font-weight:700;font-size:16px;padding:0 10px">1</span>
                <button class="btn btn-ghost" onclick="incrementPlaces()" style="border:1.5px solid var(--border);padding:7px 12px;font-size:16px">+</button>
              </div>
            </div>
          </div>

          <div style="margin-top:16px">
            <label style="display:block;margin-bottom:8px">Horaires disponibles</label>
            <div class="horaire-grid" id="horaires-container">
              <div class="horaire-btn active" onclick="selectHoraire(this)">
                <div class="horaire-time">06:00</div>
                <div class="horaire-places">67/70 places</div>
                <div class="horaire-price">4 500 FCFA</div>
              </div>
              <div class="horaire-btn" onclick="selectHoraire(this)">
                <div class="horaire-time">09:30</div>
                <div class="horaire-places">30/70 places</div>
                <div class="horaire-price">4 500 FCFA</div>
              </div>
              <div class="horaire-btn" onclick="selectHoraire(this)">
                <div class="horaire-time">13:00</div>
                <div class="horaire-places">5/70 places</div>
                <div class="horaire-price">4 500 FCFA</div>
              </div>
            </div>
          </div>

          <div class="form-grid" style="margin-top:14px">
            <div class="form-group">
              <label>Type de tarif</label>
              <select id="type-tarif">
                <option value="PLEIN">Plein tarif adulte</option>
                <option value="ENFANT">Demi-tarif enfant</option>
                <option value="GROUPE">Tarif groupe</option>
              </select>
            </div>
            <div class="form-group">
              <label>Mode paiement</label>
              <select id="mode-paiement">
                <option>Espèces</option>
                <option>Orange Money</option>
                <option>MTN MoMo</option>
              </select>
            </div>
          </div>

          <div id="billet-recap" style="background:#f0fdf4;border-radius:8px;padding:12px 14px;margin-top:14px;border:1px solid #86efac">
            <div style="font-size:12px;font-weight:700;color:#166534;margin-bottom:4px">📋 Récapitulatif</div>
            <div style="font-size:13px;color:#166534">Ydé → Dba | 06:00 | 06/05/2025 | 1 passager — <strong>4 500 F</strong></div>
            <div style="font-size:11px;color:#4ade80;margin-top:2px">Bus LT-0089 | Chauffeur: Nkoa Jean-Pierre</div>
          </div>

          <button class="btn btn-primary" onclick="nextStep()" style="width:100%;margin-top:16px;justify-content:center;padding:11px">Suivant →</button>
        </div>
      </div>

    <div class="grid-2">
      <!-- Voyages disponibles -->
      <div class="card">
        <div class="card-header"><h3>🕐 Voyages du jour</h3></div>
        <div class="card-body">
          <div id="voyages-list" style="display:flex;flex-direction:column;gap:10px">
            <div style="text-align:center;color:var(--text-muted);padding:20px">Chargement des voyages...</div>
          </div>
        </div>
      </div>

      <!-- Plan du bus -->
      <div class="card">
        <div class="card-header"><h3>🪑 Plan du bus — Sélection du siège</h3></div>
        <div class="card-body">
          <div class="seat-legend" style="margin-bottom:12px">
            <div class="legend-item"><div class="legend-dot" style="background:#bae6fd;border:1px solid #7dd3fc"></div> Libre</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--blue-accent)"></div> Sélectionné</div>
            <div class="legend-item"><div class="legend-dot" style="background:#fee2e2;border:1px solid #fca5a5"></div> Occupé</div>
          </div>
          <div class="seat-map">
            <div class="seat-map-label">AVANT</div>
            <div style="text-align:center;margin:4px 0"><span style="font-size:18px">⚙️</span></div>
            <div class="seat-row">
              <div class="seat seat-free" title="1A">1A</div>
              <div class="seat seat-selected" title="1B">1B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-free" title="1C">1C</div>
              <div class="seat seat-free" title="1D">1D</div>
            </div>
            <div class="seat-row">
              <div class="seat seat-free">2A</div>
              <div class="seat seat-free">2B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-taken">2C</div>
              <div class="seat seat-free">2D</div>
            </div>
            <div class="seat-row">
              <div class="seat seat-free">3A</div>
              <div class="seat seat-free">3B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-taken">3C</div>
              <div class="seat seat-taken">3D</div>
            </div>
            <div class="seat-row">
              <div class="seat seat-free">4A</div>
              <div class="seat seat-taken">4B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-taken">4C</div>
              <div class="seat seat-free">4D</div>
            </div>
            <div class="seat-row">
              <div class="seat seat-free">5A</div>
              <div class="seat seat-free">5B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-free">5C</div>
              <div class="seat seat-taken">5D</div>
            </div>
            <div style="border-top:2px dashed var(--border);width:100%;margin:6px 0"></div>
            <div class="seat-row">
              <div class="seat seat-free">7A</div>
              <div class="seat seat-free">7B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-free">7C</div>
              <div class="seat seat-free">7D</div>
            </div>
            <div class="seat-row">
              <div class="seat seat-free">8A</div>
              <div class="seat seat-free">8B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-taken">8C</div>
              <div class="seat seat-free">8D</div>
            </div>
            <div style="border-top:2px dashed var(--border);width:100%;margin:6px 0"></div>
            <div class="seat-row">
              <div class="seat seat-free">10A</div>
              <div class="seat seat-free">10B</div>
              <div class="seat-aisle"></div>
              <div class="seat seat-free">10C</div>
              <div class="seat seat-taken">10D</div>
            </div>
            <div class="seat-map-label">ARRIÈRE</div>
          </div>
          <div id="seat-recap" style="background:#eff6ff;border-radius:8px;padding:10px 14px;margin-top:12px;text-align:center">
            <strong>Siège sélectionné : 1B</strong> | Tarif : <strong style="color:var(--orange)">4 500 FCFA</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Billets vendus aujourd'hui -->
    <div class="card" style="margin-top:20px">
      <div class="card-header"><h3>🎫 Billets vendus aujourd'hui</h3></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>N° Billet</th><th>Passager</th><th>Voyage</th><th>Siège</th><th>Prix</th><th>Statut</th></tr>
          </thead>
          <tbody id="billets-today-tbody">
            <tr><td colspan="6" style="text-align:center;color:var(--text-muted)">Chargement...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- PAGE: COLIS                             -->
  <!-- ═══════════════════════════════════════ -->
  <div class="page" id="page-colis">
    <div class="grid-2">
      <!-- Enregistrement colis -->
      <div class="card">
        <div class="card-header">
          <h3>📦 Enregistrement d'un Colis</h3>
          <button class="btn btn-sm btn-primary">+ Nouveau</button>
        </div>
        <div class="card-body">
          <div class="form-grid">
            <div class="form-group">
              <label>Expéditeur <span class="req">*</span></label>
              <input type="text" id="colis-expediteur" value="Kamga Paul" placeholder="Nom expéditeur">
            </div>
            <div class="form-group">
              <label>Téléphone expéditeur <span class="req">*</span></label>
              <input type="tel" id="colis-expediteur-tel" value="+237 697 123 456">
            </div>
            <div class="form-group">
              <label>Destinataire <span class="req">*</span></label>
              <input type="text" id="colis-destinataire" value="Ngo Marie-Claire" placeholder="Nom destinataire">
            </div>
            <div class="form-group">
              <label>Téléphone destinataire <span class="req">*</span></label>
              <input type="tel" id="colis-destinataire-tel" value="+237 675 456 789">
            </div>
            <div class="form-group">
              <label>Ligne <span class="req">*</span></label>
              <select id="colis-ligne"><option>Ydé → Dba</option><option>Ydé → Bfm</option></select>
            </div>
            <div class="form-group">
              <label>Voyage <span class="req">*</span></label>
              <select id="colis-voyage"><option>06/05 — 13:00</option><option>06/05 — 06:00</option></select>
            </div>
            <div class="form-group">
              <label>Poids (kg)</label>
              <input type="number" id="colis-poids" value="3.5" min="0" step="0.1">
            </div>
            <div class="form-group"></div>
            <div class="form-group full">
              <label>Description du contenu</label>
              <textarea id="colis-description">Vêtements divers et accessoires de mode</textarea>
            </div>
          </div>

          <div style="margin-top:12px">
            <label style="display:block;margin-bottom:8px">Options</label>
            <div style="display:flex;gap:10px;flex-wrap:wrap">
              <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:400;color:var(--text);cursor:pointer">
                <input type="checkbox" id="colis-fragile" checked style="width:14px;height:14px"> Colis fragile (+300 FCFA)
              </label>
              <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:400;color:var(--text);cursor:pointer">
                <input type="checkbox" id="colis-urgent" style="width:14px;height:14px"> Urgent (+800 FCFA)
              </label>
              <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:400;color:var(--text);cursor:pointer">
                <input type="checkbox" id="colis-assure" style="width:14px;height:14px"> Assuré (+500 FCFA)
              </label>
            </div>
          </div>

          <div class="tarif-box" style="margin-top:14px">
            <div class="tarif-title">💰 Calcul du tarif</div>
            <div class="tarif-row"><span>Poids : 3.5 kg → tranche 1-5 kg</span><span>1 200 FCFA</span></div>
            <div class="tarif-row"><span>Supplément fragile</span><span>+ 300 FCFA</span></div>
            <div class="tarif-row tarif-total"><strong>TOTAL À PAYER</strong><strong style="color:var(--orange)">1 500 FCFA</strong></div>
          </div>

