    ],
    voyages: [
      { id: 1, depart: 'Yaoundé', arrivee: 'Douala', heure: '06:00', places: 67, tarif: 4500, bus: 'LT-0089', statut: 'EN_ROUTE' },
      { id: 2, depart: 'Yaoundé', arrivee: 'Douala', heure: '09:30', places: 30, tarif: 4500, bus: 'LT-1892', statut: 'EMBARQUEMENT' },
      { id: 3, depart: 'Yaoundé', arrivee: 'Douala', heure: '13:00', places: 5, tarif: 4500, bus: 'LT-0067', statut: 'PLANIFIE' }
    ],
    parametres: {
      nomAgence: 'Agence Voyage CM — Yaoundé',
      telephone: '+237 677 000 111',
