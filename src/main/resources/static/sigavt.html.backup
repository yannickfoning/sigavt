      '2A': 'LIBRE', '2B': 'LIBRE', '2C': 'OCCUPE', '2D': 'LIBRE',
      '3A': 'LIBRE', '3B': 'LIBRE', '3C': 'OCCUPE', '3D': 'OCCUPE',
      '4A': 'LIBRE', '4B': 'OCCUPE', '4C': 'OCCUPE', '4D': 'LIBRE',
      '5A': 'LIBRE', '5B': 'LIBRE', '5C': 'LIBRE', '5D': 'OCCUPE',
